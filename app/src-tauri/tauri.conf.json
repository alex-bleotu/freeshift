{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FreeShift",
  "mainBinaryName": "FreeShift",
  "version": "0.2.0",
  "identifier": "io.github.alexbleotu.freeshift",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "FreeShift",
        "width": 980,
        "height": 780,
        "minWidth": 400,
        "minHeight": 560,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Alex Bleotu",
    "copyright": "Copyright (c) 2026 Alex Bleotu. MIT License.",
    "category": "Utility",
    "shortDescription": "Virtual shifting for MyWhoosh from a Zwift Click and other Bluetooth controllers",
    "licenseFile": "../../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "installer-hooks.nsh"
      }
    }
  }
}
